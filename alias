export SETUP_PATH="/home/luigiferrari/setup"

myset() {
  if [ "$1" = "vim" ]; then
    vim $SETUP_PATH/alias
  elif [ "$1" = "anti" ]; then
    anti $SETUP_PATH/alias
  else
    echo "Usage: myset [vim|anti]"
  fi
}

_myset_completions() {
  local cur opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  opts="vim anti"
  COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
}
complete -F _myset_completions myset


