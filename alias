alias adit='vim ~/.bashrc'

PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]\$ '

# for programming in C language
alias aout='./a.out'
alias dout='rm ./a.out'

# for programming in Python
alias python='python3'

# for playing with docker
alias drm='docker rm -f'
alias drmi='docker rmi -f'
alias drma='docker rm -f $(docker ps -aq)'
alias drmia='docker rmi -f $(docker images -q)'
alias drmiall='drm && drmi'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias dim='docker images'
alias dl='docker logs -f'

# for playing with docker-compose
alias dcu='docker-compose up'
alias dcb='docker-compose build'
alias dcr='docker-compose run'

# expand all env variables from a file
expand () {
        export $(cat "$1" | xargs)
}

# create e virtual environment for python
cvenv () {
        python3 -m venv ~/bin/venv/"$1"
}

svenv () {
        source ~/bin/venv/"$1"/bin/activate
}

rvenv () {
        rm -rf ~/bin/venv/"$1"
}

alias gco='git checkout'
alias gcob='git checkout -b'
alias gst='git status'
gci () {
        git commit -m "$1"
}

gcia () {
        git commit --amend -m "$1"
}

gcian () {
        git commit --amend --no-edit
}


# for playing with git
alias gbr='git branch'
alias gps='git push'
alias gpl='git pull'
alias gpsf='git push --force'
alias gpsu='git push -u orgin'
alias grb='git rebase'
alias grt='git reset --hard'


